<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Developer Options"
            android:textColor="@color/green"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dev_section"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_device_level_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Level"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_device_level_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Device Level:"
                android:textColor="@color/green"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_device_level_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_device_level_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_no_value"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_device_level_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_max_size_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Max Size:"
                android:textColor="@color/green"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_device_level_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_max_size_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_no_value"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_device_level_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_low_ram_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Low RAM:"
                android:textColor="@color/green"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_max_size_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_low_ram_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_no_value"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_max_size_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_cpu_cores_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="CPU Cores:"
                android:textColor="@color/green"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_low_ram_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_cpu_cores_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_no_value"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_low_ram_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_cpu_freq_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="CPU Freq (MHz):"
                android:textColor="@color/green"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_cpu_cores_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_cpu_freq_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_no_value"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_cpu_cores_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_ram_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="RAM (MB):"
                android:textColor="@color/green"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_cpu_freq_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_ram_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_no_value"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_cpu_freq_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_storage_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Storage (MB):"
                android:textColor="@color/green"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_ram_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_storage_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_no_value"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_ram_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_gles_version_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="GLES Version:"
                android:textColor="@color/green"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_storage_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_gles_version_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_no_value"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_storage_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:paddingHorizontal="16dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_gles_version_label" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/edit_bg"
    android:clickable="true">

    <LinearLayout
        android:id="@+id/ll_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/theme_bg"
        android:orientation="horizontal"
        android:clickable="true">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_cancel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_close"
            android:padding="4dp"
            android:foreground="@drawable/ripple_rounded_r1000"
            android:layout_marginStart="8dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/FontMedium"
            android:text="@string/elimination"
            android:textColor="@color/white_default"
            android:textSize="16sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_confirm"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_tick"
            android:padding="2dp"
            android:foreground="@drawable/ripple_rounded_r1000"
            android:layout_marginEnd="8dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_function"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/ll_bottom_bar"
        android:orientation="horizontal"
        android:background="@color/theme_bg"
        android:paddingVertical="16dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/ll_paint"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_paint"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:padding="4dp"
                app:srcCompat="@drawable/ic_paint"
                android:tint="@color/color_stateful_theme_white"
                android:duplicateParentState="true" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_paint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                style="@style/FontRegular"
                android:text="@string/paint"
                android:textColor="@color/color_stateful_theme_white"
                android:textSize="12sp"
                android:duplicateParentState="true" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_lariat"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_lariat"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:padding="4dp"
                app:srcCompat="@drawable/ic_lariat"
                android:tint="@color/color_stateful_theme_white"
                android:duplicateParentState="true" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_lariat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                style="@style/FontRegular"
                android:text="@string/lariat"
                android:textColor="@color/color_stateful_theme_white"
                android:textSize="12sp"
                android:duplicateParentState="true" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_eraser"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_eraser"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:padding="4dp"
                app:srcCompat="@drawable/ic_eraser"
                android:tint="@color/color_stateful_theme_white"
                android:duplicateParentState="true" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_eraser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                style="@style/FontRegular"
                android:text="@string/eraser"
                android:textColor="@color/color_stateful_theme_white"
                android:textSize="12sp"
                android:duplicateParentState="true" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_generate"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_generate"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:padding="4dp"
                app:srcCompat="@drawable/ic_generate" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_generate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                style="@style/FontRegular"
                android:text="@string/generate"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <com.davemorrissey.labs.subscaleview.SubsamplingScaleImageView
        android:id="@+id/iv_elimination"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ll_function" />

    <com.tgwgroup.zhoupics.ui.edit.elimination.EliminatePaintView
        android:id="@+id/v_eliminate_paint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/iv_elimination"
        app:layout_constraintBottom_toBottomOf="@id/iv_elimination"
        app:layout_constraintStart_toStartOf="@id/iv_elimination"
        app:layout_constraintEnd_toEndOf="@id/iv_elimination" />
    
    <com.tgwgroup.zhoupics.ui.edit.elimination.EliminateZoomView
        android:id="@+id/v_eliminate_zoom"
        android:layout_width="@dimen/zoom_area_width"
        android:layout_height="@dimen/zoom_area_height"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_eliminate_zoom_view"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <com.tgwgroup.zhoupics.widgets.SliderBubble
        android:id="@+id/slider_bubble"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toTopOf="@id/slider"
        app:layout_constraintStart_toStartOf="@id/slider"
        android:translationY="12dp" />

    <View
        android:id="@+id/v_slider_gradient"
        android:layout_width="match_parent"
        android:layout_height="@dimen/slider_height"
        app:layout_constraintTop_toTopOf="@id/slider"
        android:background="@drawable/bg_slider_gradient"
        android:visibility="invisible"
        tools:visibility="visible" />

    <com.tgwgroup.zhoupics.widgets.BidirectionalSlider
        android:id="@+id/slider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/slider_height"
        app:layout_constraintBottom_toTopOf="@id/ll_function"
        android:layout_marginHorizontal="32dp"
        app:bidirectional="true"
        app:minValue="-100"
        app:maxValue="100"
        app:defaultProgress="0"
        android:visibility="invisible"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
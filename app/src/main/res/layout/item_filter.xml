<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="72dp"
    android:layout_height="80dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingEnd="8dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_filter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/img_filter_beauty"
        android:scaleType="centerCrop" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/filter_color_brown_light"
        style="@style/FontRegular"
        android:textSize="10sp"
        android:textColor="@color/white"
        android:text="@string/filter_fairy_tale"
        android:textAlignment="center"
        android:paddingVertical="2dp"/>

    <FrameLayout
        android:id="@+id/fl_selected"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_name"
        android:background="@color/filter_color_brown_light_75p"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            app:srcCompat="@drawable/ic_tick"
            android:layout_marginTop="16dp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
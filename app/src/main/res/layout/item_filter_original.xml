<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="80dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Space
        android:id="@+id/space_0"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_filter"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/img_filter_original"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/space_0" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/iv_filter"
        app:layout_constraintEnd_toEndOf="@id/iv_filter"
        android:background="@color/filter_color_grey_light"
        style="@style/FontRegular"
        android:textSize="10sp"
        android:textColor="@color/white"
        android:text="@string/filter_original"
        android:textAlignment="center"
        android:paddingVertical="2dp" />

    <FrameLayout
        android:id="@+id/fl_selected"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_name"
        app:layout_constraintStart_toStartOf="@id/iv_filter"
        app:layout_constraintEnd_toEndOf="@id/iv_filter"
        android:background="@color/filter_color_brown_light_75p"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            app:srcCompat="@drawable/ic_tick"
            android:layout_marginTop="16dp" />

    </FrameLayout>

    <Space
        android:id="@+id/space_1"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@id/iv_filter" />

    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="64dp"
        android:background="@color/divider"
        app:layout_constraintStart_toEndOf="@id/space_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Space
        android:id="@+id/space_2"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@id/divider" />

</androidx.constraintlayout.widget.ConstraintLayout>
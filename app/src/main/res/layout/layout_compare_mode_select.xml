<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/theme_bg"
    android:paddingVertical="16dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_precise_mode"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginHorizontal="32dp"
        style="@style/FontBold"
        android:text="@string/precise_mode"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:background="@drawable/shape_bg_r20"
        android:backgroundTint="@color/theme_opposite"
        android:foreground="@drawable/dark_ripple_rounded_r20" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_fast_mode"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_precise_mode"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        style="@style/FontBold"
        android:text="@string/fast_mode"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:background="@drawable/shape_bg_r20"
        android:backgroundTint="@color/theme"
        android:foreground="@drawable/ripple_rounded_r20" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="BidirectionalSlider">
        <attr name="bidirectional" format="boolean" />
        <attr name="minValue" format="float" />
        <attr name="maxValue" format="float" />
        <attr name="defaultProgress" format="float" />
    </declare-styleable>

    <declare-styleable name="DownloadProgressView">
        <attr name="progress" format="float" />
        <attr name="fillColor" format="color" />
        <attr name="backgroundColor" format="color" />
        <attr name="pixelSize" format="integer" />
    </declare-styleable>
</resources>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ZhouPics" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/theme</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Theme.ZhouPics" parent="Base.Theme.ZhouPics" />

    <style name="Theme.ZhouPics.EditActivity" parent="Theme.ZhouPics">
        <item name="android:statusBarColor">@color/theme_bg</item>
        <item name="android:navigationBarColor">@color/theme_bg</item>
    </style>

    <style name="Theme.ZhouPics.GalleryActivity" parent="Theme.ZhouPics">
        <item name="android:statusBarColor">@color/theme_opposite_20p</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
    </style>

    <style name="Theme.ZhouPics.CompareLoadingActivity" parent="Theme.ZhouPics">
        <item name="android:statusBarColor">@color/theme_50p</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
    </style>

    <style name="Theme.ZhouPics.DownloadsActivity" parent="Theme.ZhouPics">
        <item name="colorPrimary">@color/filter_color_brown_light</item>
    </style>
</resources>